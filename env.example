APP_ENV=local
DATABASE_URL=postgresql+asyncpg://task_user:task_pass@postgres:5432/tasks
RABBITMQ_URL=amqp://guest:guest@rabbitmq/

QUEUE_HIGH=tasks.high
QUEUE_MEDIUM=tasks.medium
QUEUE_LOW=tasks.low

WORKER_CONCURRENCY=4
TASK_EXECUTION_TIMEOUT=300
METRICS_ENABLED=true
METRICS_PORT=9000
WORKER_REQUEUE_ON_FAIL=false
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2
AUTO_STATUS_UPDATES=false
DATABASE_URL=postgresql+asyncpg://task_user:task_pass@postgres:5432/tasks

